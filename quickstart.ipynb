    "def predict_blend_on_fold(feature_frame, feature_columns, fold, seeds):\n",
    "    valid_start, valid_end = fold\n",
    "    train_mask = window_start.lt(valid_start).to_numpy()\n",
    "    valid_mask = window_start.ge(valid_start).to_numpy() & window_start.lt(valid_end).to_numpy()\n",
    "\n",
    "    model_predictions = []\n",
    "    for model_name in ['catboost', 'lightgbm']:\n",
    "        seed_predictions = []\n",
    "        for seed in seeds:\n",
    "            prediction = fit_and_predict(\n",
    "                model_name,\n",
    "                feature_frame.loc[train_mask],\n",
    "                target[train_mask],\n",
    "                feature_frame.loc[valid_mask],\n",
    "                feature_columns,\n",
    "                seed,\n",
    "            )\n",
    "            seed_predictions.append(prediction)\n",
    "        model_predictions.append(np.mean(seed_predictions, axis=0))\n",
    "\n",
    "    return target[valid_mask], rank_blend(model_predictions)\n",
    "\n",
    "\n",
    "holdout_target, baseline_holdout_prediction = predict_blend_on_fold(\n",
    "    baseline_train, baseline_columns, HOLDOUT_FOLD, RANDOM_SEEDS\n",
    ")\n",
    "_, enhanced_holdout_prediction = predict_blend_on_fold(\n",
    "    enhanced_train, enhanced_columns, HOLDOUT_FOLD, RANDOM_SEEDS\n",
    ")\n",
    "\n",
    "holdout_results = pd.DataFrame({\n",
    "    'baseline': {\n",
    "        'P@R0.7': precision_at_recall(holdout_target, baseline_holdout_prediction),\n",
    "        'PR-AUC': average_precision_score(holdout_target, baseline_holdout_prediction),\n",
    "    },\n",
    "    'enhanced': {\n",
    "        'P@R0.7': precision_at_recall(holdout_target, enhanced_holdout_prediction),\n",
    "        'PR-AUC': average_precision_score(holdout_target, enhanced_holdout_prediction),\n",
    "    },\n",
    "}).T\n",
    "display(holdout_results.round(4))"
   ]
  },
