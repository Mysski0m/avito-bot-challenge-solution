  {
   "cell_type": "markdown",
   "id": "19fb8c14",
   "metadata": {},
   "source": [
    "## 5. Baseline-признаки\n",
    "\n",
    "Одна кука является одним объектом модели. Для первого решения я использую только очевидные агрегаты: объём и разнообразие активности, счётчики типов событий, два простых тайминга, наличие курсора, глубину поиска, платформу и возраст куки. Более сложные статистики рассчитываются тем же кодом, но передаются только enhanced-модели.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 115,
   "id": "a2e42f6b",
   "metadata": {},
   "outputs": [],
   "source": [
    "EVENT_NAMES = sorted(events.event_name.dropna().unique())\n",
    "CATEGORICAL_COLUMNS = ['platform', 'browser', 'os', 'device_brand', 'device_model']\n",
    "\n",
    "\n",
    "def most_common_value(frame, column):\n",
    "    counts = frame.groupby(['cookie_id', column]).size().reset_index(name='count')\n",
    "    counts = counts.sort_values(['cookie_id', 'count', column], ascending=[True, False, True])\n",
    "    return counts.drop_duplicates('cookie_id').set_index('cookie_id')[column]\n",
    "\n",
    "\n",
    "def entropy_by_cookie(frame, column):\n",
    "    counts = frame.groupby(['cookie_id', column]).size()\n",
    "    probabilities = counts / counts.groupby(level=0).transform('sum')\n",
    "    return -(probabilities * np.log(probabilities)).groupby(level=0).sum()\n",
    "\n",
    "\n",
    "def build_baseline_features(meta, prepared_events, duplicate_counts):\n",
    "    grouped = prepared_events.groupby('cookie_id')\n",
    "    features = pd.DataFrame(index=meta.cookie_id)\n",
    "\n",
    "    # Объём и разнообразие\n",
    "    features['n_events'] = grouped.size()\n",
    "    features['n_duplicates'] = duplicate_counts\n",
    "    features['n_items'] = grouped.item_id.nunique()\n",
    "    features['n_categories'] = grouped.item_category.nunique()\n",
    "    features['n_locations'] = grouped.item_location.nunique()\n",
    "    features['n_queries'] = grouped.search_query.nunique()\n",
    "    features['n_user_agents'] = grouped.user_agent.nunique()\n",
    "\n",
    "    item_events = prepared_events.item_id.notna().groupby(prepared_events.cookie_id).sum()\n",
    "    features['items_per_event'] = features.n_items / features.n_events\n",
    "    features['item_repeat_share'] = 1 - features.n_items / item_events.replace(0, np.nan)\n",
    "\n",
    "    # Состав событий\n",
    "    event_counts = pd.crosstab(prepared_events.cookie_id, prepared_events.event_name)\n",
    "    for event_name in EVENT_NAMES:\n",
    "        count = event_counts[event_name] if event_name in event_counts else 0\n",
    "        features[f'count_{event_name}'] = count\n",
    "        features[f'share_{event_name}'] = count / features.n_events\n",
    "\n",
    "    # Интервалы и активность\n",
    "    gaps = grouped.gap_seconds\n",
    "    features['gap_median'] = gaps.median()\n",
    "    features['gap_min'] = gaps.min()\n",
    "    features['gap_p10'] = gaps.quantile(0.1)\n",
    "    features['gap_p90'] = gaps.quantile(0.9)\n",
    "    features['gap_std'] = gaps.std()\n",
    "    features['gap_share_30s'] = prepared_events.gap_seconds.le(30).groupby(prepared_events.cookie_id).mean()\n",
    "    features['gap_share_60s'] = prepared_events.gap_seconds.le(60).groupby(prepared_events.cookie_id).mean()\n",
    "    features['active_hours'] = grouped.hour.nunique()\n",
    "    features['first_event_second'] = grouped.seconds_from_start.min()\n",
    "    features['last_event_second'] = grouped.seconds_from_start.max()\n",
    "    features['activity_span'] = features.last_event_second - features.first_event_second\n",
    "\n",
    "    # Курсор\n",
    "    pointer = prepared_events[prepared_events.pointer_x.notna() & prepared_events.pointer_y.notna()].copy()\n",
    "    pointer['step'] = np.hypot(\n",
    "        pointer.groupby('cookie_id').pointer_x.diff(),\n",
    "        pointer.groupby('cookie_id').pointer_y.diff(),\n",
    "    )\n",
    "    pointer_grouped = pointer.groupby('cookie_id')\n",
    "    features['pointer_count'] = pointer_grouped.size()\n",
    "    features['pointer_x_std'] = pointer_grouped.pointer_x.std()\n",
    "    features['pointer_y_std'] = pointer_grouped.pointer_y.std()\n",
    "    features['pointer_step_mean'] = pointer_grouped.step.mean()\n",
    "    features['pointer_step_max'] = pointer_grouped.step.max()\n",
    "\n",
    "    web = prepared_events[prepared_events.platform_clean.eq('web')].copy()\n",
    "    web['has_pointer'] = web.pointer_x.notna() & web.pointer_y.notna()\n",
    "    features['pointer_share_web'] = web.groupby('cookie_id').has_pointer.mean()\n",
    "\n",
    "    # Поиск и охват\n",
    "    search = prepared_events[prepared_events.event_name.eq('search_results_view')]\n",
    "    search_grouped = search.groupby('cookie_id')\n",
    "    features['max_search_page'] = search_grouped.search_page.max()\n",
    "    features['mean_search_page'] = search_grouped.search_page.mean()\n",
    "    features['category_entropy'] = entropy_by_cookie(prepared_events, 'item_category')\n",
    "\n",
    "    # Платформа и User-Agent\n",
    "    features['platform'] = most_common_value(prepared_events, 'platform_clean')\n",
    "    features['browser'] = most_common_value(prepared_events, 'browser')\n",
    "    features['os'] = most_common_value(prepared_events, 'os')\n",
    "    features['device_brand'] = most_common_value(prepared_events, 'device_brand')\n",
    "    features['device_model'] = most_common_value(prepared_events, 'device_model')\n",
    "    features['browser_version'] = grouped.browser_version.first()\n",
    "    features['os_version'] = grouped.os_version.first()\n",
    "    features['is_script'] = grouped.is_script.max()\n",
    "    features['is_app'] = grouped.is_app.max()\n",
    "\n",
    "    features = features.reset_index()\n",
    "    age_days = (meta.window_start_ts - meta.cookie_created_at).dt.total_seconds() / 86400\n",
    "    features['cookie_age_days'] = age_days.values\n",
    "    features['no_events'] = features.n_events.isna().astype(int)\n",
    "\n",
    "    count_columns = [\n",
    "        column for column in features.columns\n",
    "        if column.startswith('count_')\n",
    "    ] + ['n_events', 'n_duplicates', 'n_items', 'n_categories', 'n_locations',\n",
    "         'n_queries', 'n_user_agents', 'pointer_count']\n",
    "    features[count_columns] = features[count_columns].fillna(0)\n",
    "    for column in CATEGORICAL_COLUMNS:\n",
    "        features[column] = features[column].fillna('none')\n",
    "\n",
    "    return features"
   ]
  },
