   "source": [
    "**Вывод.** Train и test разделены по времени. Платформа записана в разных регистрах, поэтому её нужно нормализовать. Пропуски зависят от типа события и платформы: например, отсутствие координат на mobile является нормой и не должно трактоваться как ноль.\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b663c2f0",
   "metadata": {},
   "source": [
    "## 3. Подготовка событий\n",
    "\n",
    "Для каждой куки я оставляю только события внутри её окна наблюдения. Затем удаляю точные дубли и сортирую события по времени. Без сортировки интервалы и последовательности будут рассчитаны неверно.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "67db6305",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Шаблоны составлены после просмотра наиболее частых User-Agent.\n",
    "# Первый находит признаки популярных библиотек и инструментов для автоматических запросов.\n",
    "# Второй извлекает номер версии приложения из User-Agent формата Avito/версия.\n",
    "SCRIPT_PATTERN = re.compile(r'curl|python|node-fetch|Go-http|Scrapy|requests|urllib', re.I)\n",
    "APP_VERSION_PATTERN = re.compile(r'Avito/(\\d+(?:\\.\\d+)?)')\n",
    "\n",
    "\n",
    "def to_number(value):\n",
    "    if value is None:\n",
    "        return np.nan\n",
    "    value = str(value)\n",
    "    return float(value) if value.isdigit() else np.nan\n",
    "\n",
    "\n",
    "def parse_ua(value):\n",
    "    if not isinstance(value, str):\n",
    "        return {\n",
    "            'user_agent': value, 'browser': 'unknown', 'browser_version': np.nan,\n",
    "            'os': 'unknown', 'os_version': np.nan, 'device_brand': 'none',\n",
    "            'device_model': 'none', 'is_script': 0, 'is_app': 0,\n",
    "        }\n",
    "\n",
    "    parsed = parse_user_agent(value).with_defaults()\n",
    "    return {\n",
    "        'user_agent': value,\n",
    "        'browser': parsed.user_agent.family,\n",
    "        'browser_version': to_number(parsed.user_agent.major),\n",
    "        'os': parsed.os.family,\n",
    "        'os_version': to_number(parsed.os.major),\n",
    "        'device_brand': parsed.device.brand or 'none',\n",
    "        'device_model': parsed.device.model or 'none',\n",
    "        'is_script': int(bool(SCRIPT_PATTERN.search(value))),\n",
    "        'is_app': int('okhttp' in value or APP_VERSION_PATTERN.search(value) is not None),\n",
    "    }\n",
    "\n",
    "\n",
    "def make_ua_table(values):\n",
    "    unique_values = pd.Series(values).drop_duplicates()\n",
    "    return pd.DataFrame([parse_ua(value) for value in unique_values])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 111,
   "id": "bf5703d9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "событий train внутри окна: 195484\n",
      "событий test внутри окна: 88349\n",
      "точных дублей train: 2952\n"
     ]
    }
   ],
   "source": [
    "def prepare_events(meta, all_events, drop_duplicates=True):\n",
    "    meta_columns = ['cookie_id', 'window_start_ts', 'window_end_ts']\n",
    "    prepared = all_events.merge(meta[meta_columns], on='cookie_id', how='inner')\n",
    "\n",
    "    inside_window = (\n",
    "        (prepared.event_ts >= prepared.window_start_ts)\n",
    "        & (prepared.event_ts < prepared.window_end_ts)\n",
    "    )\n",
    "    prepared = prepared.loc[inside_window].copy()\n",
    "\n",
    "    event_columns = list(all_events.columns)\n",
    "    raw_counts = prepared.groupby('cookie_id').size()\n",
    "    duplicate_mask = prepared.duplicated(event_columns, keep='first')\n",
    "    duplicate_counts = duplicate_mask.groupby(prepared.cookie_id).sum().rename('n_duplicates')\n",
    "\n",
    "    if drop_duplicates:\n",
    "        prepared = prepared.loc[~duplicate_mask].copy()\n",
    "\n",
    "    prepared = prepared.sort_values(\n",
    "        ['cookie_id', 'event_ts'], kind='mergesort'\n",
    "    ).reset_index(drop=True)\n",
    "    prepared['platform_clean'] = (\n",
    "        prepared.platform.str.lower().replace({'desktop': 'web', 'iphone': 'ios'})\n",
    "    )\n",
    "    prepared['seconds_from_start'] = (\n",
    "        prepared.event_ts - prepared.window_start_ts\n",
    "    ).dt.total_seconds()\n",
    "    prepared['gap_seconds'] = prepared.groupby('cookie_id').event_ts.diff().dt.total_seconds()\n",
    "    prepared['hour'] = prepared.event_ts.dt.hour\n",
    "    prepared['minute'] = prepared.event_ts.dt.floor('min')\n",
    "\n",
    "    ua_table = make_ua_table(prepared.user_agent)\n",
    "    prepared = prepared.merge(ua_table, on='user_agent', how='left')\n",
    "\n",
    "    duplicate_counts = duplicate_counts.reindex(meta.cookie_id, fill_value=0)\n",
    "    return prepared, duplicate_counts, raw_counts\n",
    "\n",
    "\n",
    "train_events, train_duplicate_counts, _ = prepare_events(train, events)\n",
    "test_events, test_duplicate_counts, _ = prepare_events(test, events)\n",
    "\n",
    "print('событий train внутри окна:', len(train_events))\n",
    "print('событий test внутри окна:', len(test_events))\n",
    "print('точных дублей train:', int(train_duplicate_counts.sum()))"
   ]
  },
