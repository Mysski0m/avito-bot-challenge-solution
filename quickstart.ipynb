    "def train_final_blend(train_frame, test_frame, feature_columns, seeds):\n",
    "    model_predictions = []\n",
    "    for model_name in ['catboost', 'lightgbm']:\n",
    "        seed_predictions = []\n",
    "        for seed in seeds:\n",
    "            prediction = fit_and_predict(\n",
    "                model_name,\n",
    "                train_frame,\n",
    "                target,\n",
    "                test_frame,\n",
    "                feature_columns,\n",
    "                seed,\n",
    "            )\n",
    "            seed_predictions.append(prediction)\n",
    "        model_predictions.append(np.mean(seed_predictions, axis=0))\n",
    "    return rank_blend(model_predictions)\n",
    "\n",
    "\n",
    "test_score = train_final_blend(\n",
    "    enhanced_train,\n",
    "    enhanced_test,\n",
    "    enhanced_columns,\n",
    "    RANDOM_SEEDS,\n",
    ")\n",
    "\n",
    "submission = pd.DataFrame({\n",
    "    'cookie_id': test.cookie_id,\n",
    "    'score': test_score,\n",
    "})\n",
    "\n",
    "assert len(submission) == len(test)\n",
    "assert submission.cookie_id.is_unique\n",
    "assert submission.score.notna().all()\n",
    "assert submission.score.between(0, 1).all()\n",
    "\n",
    "submission.to_csv('submission.csv', index=False)\n",
    "print('submission.csv:', submission.shape)\n",
    "print('Уникальных cookies:', submission.cookie_id.nunique())\n",
    "print('Доля уникальных score:', round(submission.score.nunique() / len(submission), 3))\n",
    "submission.head()"
   ]
  },
