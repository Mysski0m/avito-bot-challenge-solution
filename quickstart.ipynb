    "def build_regularity_features(meta, prepared_events):\n",
    "    gap_data = prepared_events.loc[\n",
    "        prepared_events.gap_seconds.notna(), ['cookie_id', 'gap_seconds']\n",
    "    ].copy()\n",
    "    grouped = gap_data.groupby('cookie_id').gap_seconds\n",
    "\n",
    "    features = pd.DataFrame(index=meta.cookie_id)\n",
    "    features['gap_unique_share'] = grouped.nunique() / grouped.size()\n",
    "\n",
    "    median_gap = grouped.median()\n",
    "    gap_data['distance_from_median'] = (\n",
    "        gap_data.gap_seconds - gap_data.cookie_id.map(median_gap)\n",
    "    ).abs()\n",
    "    features['gap_mad'] = gap_data.groupby('cookie_id').distance_from_median.median()\n",
    "\n",
    "    gap_data['gap_change'] = gap_data.groupby('cookie_id').gap_seconds.diff().abs()\n",
    "    features['gap_repeat_10s'] = (\n",
    "        gap_data.gap_change.le(10)\n",
    "        .where(gap_data.gap_change.notna())\n",
    "        .groupby(gap_data.cookie_id)\n",
    "        .mean()\n",
    "    )\n",
    "    return features.reset_index()\n",
    "\n",
    "\n",
    "def build_pointer_type_features(meta, prepared_events):\n",
    "    web = prepared_events[prepared_events.platform_clean.eq('web')].copy()\n",
    "    web['has_pointer'] = web.pointer_x.notna() & web.pointer_y.notna()\n",
    "\n",
    "    event_groups = {\n",
    "        'search': ['search_results_view'],\n",
    "        'item': ['item_view'],\n",
    "        'photo': ['photo_swipe'],\n",
    "        'seller': ['seller_page_view'],\n",
    "        'contact': ['contact_phone_show', 'contact_chat_open', 'contact_message_sent'],\n",
    "    }\n",
    "\n",
    "    features = pd.DataFrame(index=meta.cookie_id)\n",
    "    for group_name, event_names in event_groups.items():\n",
    "        selected = web[web.event_name.isin(event_names)]\n",
    "        features[f'pointer_share_{group_name}'] = (\n",
    "            selected.groupby('cookie_id').has_pointer.mean()\n",
    "        )\n",
    "    return features.reset_index()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5c35d8b3",
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_item_sync_features(meta, prepared_events):\n",
    "    item_events = prepared_events.loc[\n",
    "        prepared_events.item_id.notna(),\n",
    "        ['cookie_id', 'window_start_ts', 'event_ts', 'item_id'],\n",
    "    ].copy()\n",
    "    item_events['day'] = item_events.window_start_ts.dt.normalize()\n",
    "\n",
    "    # Сколько других куки в тот же день взаимодействовали с объявлением.\n",
    "    daily_count = item_events.groupby(['day', 'item_id']).cookie_id.transform('nunique')\n",
    "    item_events['other_cookies_day'] = (daily_count - 1).clip(lower=0)\n",
    "\n",
    "    # Минутные корзины с двумя смещниями уменьшают влияние границы минуты.\n",
    "    seconds = item_events.event_ts.astype('int64') // 10**9\n",
    "    sync_counts = []\n",
    "    for offset in [0, 30]:\n",
    "        minute_bucket = (seconds + offset) // 60\n",
    "        count = (\n",
    "            item_events.assign(minute_bucket=minute_bucket)\n",
    "            .groupby(['item_id', 'minute_bucket'])\n",
    "            .cookie_id.transform('nunique')\n",
    "        )\n",
    "        sync_counts.append((count - 1).clip(lower=0))\n",
    "    item_events['other_cookies_minute'] = pd.concat(sync_counts, axis=1).max(axis=1)\n",
    "\n",
    "    features = pd.DataFrame(index=meta.cookie_id)\n",
    "    day_group = item_events.groupby('cookie_id').other_cookies_day\n",
    "    minute_group = item_events.groupby('cookie_id').other_cookies_minute\n",
    "\n",
    "    features['item_shared_mean'] = day_group.mean()\n",
    "    features['item_shared_max'] = day_group.max()\n",
    "    features['item_shared_share'] = (\n",
    "        item_events.other_cookies_day.gt(0).groupby(item_events.cookie_id).mean()\n",
    "    )\n",
    "    features['item_sync_mean'] = minute_group.mean()\n",
    "    features['item_sync_max'] = minute_group.max()\n",
    "    features['item_sync_share'] = (\n",
    "        item_events.other_cookies_minute.gt(0).groupby(item_events.cookie_id).mean()\n",
    "    )\n",
    "    return features.reset_index()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "aa93b307",
   "metadata": {
    "solution_note": "sync"
   },
   "source": [
    "<!-- solution-note:sync -->\n",
    "\n",
    "**Почему синхронность допустима.** Эти признаки строятся без `target`: используется только то, сколько других куки в тот же день или минуту взаимодействовали с объявлением. Для train и test расчёт одинаковый. Повторные действия одной куки по одному объявлению предварительно дедуплицируются, чтобы не завышать сигнал.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "94a773cc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Дополнительные признаки из предыдущей версии\n",
    "def extract_app_version(user_agent):\n",
    "    if not isinstance(user_agent, str):\n",
    "        return np.nan\n",
    "    match = APP_VERSION_PATTERN.search(user_agent)\n",
    "    return float(match.group(1)) if match else np.nan\n",
    "\n",
    "\n",
    "def build_restored_features(meta, prepared_events):\n",
    "    grouped = prepared_events.groupby('cookie_id')\n",
    "    features = pd.DataFrame(index=meta.cookie_id)\n",
    "\n",
    "    # Доплнительные характеристики интервалов\n",
    "    gaps = grouped.gap_seconds\n",
    "    features['n_gaps'] = gaps.count()\n",
    "    features['gap_mean'] = gaps.mean()\n",
    "    features['gap_max'] = gaps.max()\n",
    "    gap_std = gaps.std()\n",
    "    features['gap_cv'] = gap_std / features.gap_mean\n",
    "    features['gap_burst'] = (\n",
    "        (gap_std - features.gap_mean)\n",
    "        / (gap_std + features.gap_mean)\n",
    "    )\n",
    "\n",
    "    valid_gaps = prepared_events.gap_seconds.notna()\n",
    "    for limit in [5, 10]:\n",
    "        is_short = prepared_events.gap_seconds.le(limit).where(valid_gaps)\n",
    "        features[f'gap_share_{limit}s'] = is_short.groupby(prepared_events.cookie_id).mean()\n",
    "\n",
    "    # Разнообразие и повторяемость курсора\n",
    "    pointer = prepared_events[\n",
    "        prepared_events.pointer_x.notna() & prepared_events.pointer_y.notna()\n",
    "    ].copy()\n",
    "    pointer['step'] = np.hypot(\n",
    "        pointer.groupby('cookie_id').pointer_x.diff(),\n",
    "        pointer.groupby('cookie_id').pointer_y.diff(),\n",
    "    )\n",
    "    pointer_grouped = pointer.groupby('cookie_id')\n",
    "    features['pointer_x_unique'] = pointer_grouped.pointer_x.nunique()\n",
    "    same_point = pointer.step.eq(0).where(pointer.step.notna())\n",
    "    features['pointer_same_share'] = same_point.groupby(pointer.cookie_id).mean()\n",
    "\n",
    "    # Глубина поиска и концентрация по категориям\n",
    "    search = prepared_events[prepared_events.event_name.eq('search_results_view')].copy()\n",
    "    search['page_step'] = search.groupby('cookie_id').search_page.diff()\n",
    "    search_grouped = search.groupby('cookie_id')\n",
    "\n",
    "    features['n_search_events'] = search_grouped.size()\n",
    "    features['n_search_pages'] = search_grouped.search_page.nunique()\n",
    "    features['search_page_range'] = (\n",
    "        search_grouped.search_page.max() - search_grouped.search_page.min()\n",
    "    )\n",
    "    features['deep_search_share'] = (\n",
    "        search.search_page.ge(3).groupby(search.cookie_id).mean()\n",
    "    )\n",
    "    features['sequential_page_share'] = (\n",
    "        search.page_step.eq(1)\n",
    "        .where(search.page_step.notna())\n",
    "        .groupby(search.cookie_id)\n",
    "        .mean()\n",
    "    )\n",
    "\n",
    "    category_counts = prepared_events.groupby(['cookie_id', 'item_category']).size()\n",
    "    category_total = category_counts.groupby(level=0).sum()\n",
    "    features['top_category_share'] = (\n",
    "        category_counts.groupby(level=0).max() / category_total\n",
    "    )\n",
    "\n",
    "    query_count = grouped.search_query.nunique()\n",
    "    features['query_repeat_share'] = (\n",
    "        1 - query_count / features.n_search_events.replace(0, np.nan)\n",
    "    )\n",
    "\n",
    "    # Разнообразие среды и дополнителные признаки User-Agent\n",
    "    features['n_seller_types'] = grouped.seller_type.nunique()\n",
    "    features['n_platforms'] = grouped.platform_clean.nunique()\n",
    "    features['is_headless'] = (\n",
    "        prepared_events.user_agent.fillna('').str.contains('Headless', case=False)\n",
    "        .groupby(prepared_events.cookie_id)\n",
    "        .max()\n",
    "        .astype(float)\n",
    "    )\n",
    "    app_versions = prepared_events.user_agent.map(extract_app_version)\n",
    "    features['app_version'] = app_versions.groupby(prepared_events.cookie_id).first()\n",
    "\n",
    "    return features.reset_index()"
   ]
  },
