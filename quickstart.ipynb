    "## 6. Временная валидация и модели\n",
    "\n",
    "Для каждого фолда модель обучается на всех датах до начала validation и предсказывает следующий период. CatBoost и LightGBM обучаются отдельно, затем их ранги усредняются.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1714e275",
   "metadata": {},
   "outputs": [],
   "source": [
    "def prepare_lightgbm_data(train_frame, valid_frame, feature_columns):\n",
    "    train_frame = train_frame[feature_columns].copy()\n",
    "    valid_frame = valid_frame[feature_columns].copy()\n",
    "\n",
    "    for column in CATEGORICAL_COLUMNS:\n",
    "        if column not in feature_columns:\n",
    "            continue\n",
    "        categories = pd.Categorical(\n",
    "            pd.concat([train_frame[column], valid_frame[column]])\n",
    "        ).categories\n",
    "        train_frame[column] = pd.Categorical(train_frame[column], categories=categories)\n",
    "        valid_frame[column] = pd.Categorical(valid_frame[column], categories=categories)\n",
    "    return train_frame, valid_frame\n",
    "\n",
    "\n",
    "def fit_and_predict(model_name, train_frame, train_target, valid_frame,\n",
    "                    feature_columns, seed=0):\n",
    "    if model_name == 'catboost':\n",
    "        category_columns = [c for c in CATEGORICAL_COLUMNS if c in feature_columns]\n",
    "        model = CatBoostClassifier(\n",
    "            random_seed=seed,\n",
    "            cat_features=category_columns,\n",
    "            **CATBOOST_PARAMS,\n",
    "        )\n",
    "        model.fit(train_frame[feature_columns], train_target)\n",
    "        return model.predict_proba(valid_frame[feature_columns])[:, 1]\n",
    "\n",
    "    lightgbm_train, lightgbm_valid = prepare_lightgbm_data(\n",
    "        train_frame, valid_frame, feature_columns\n",
    "    )\n",
    "    model = lgb.LGBMClassifier(random_state=seed, **LIGHTGBM_PARAMS)\n",
    "    model.fit(lightgbm_train, train_target)\n",
    "    return model.predict_proba(lightgbm_valid)[:, 1]\n",
    "\n",
    "\n",
    "def rank_blend(predictions):\n",
    "    ranks = [rankdata(values) / len(values) for values in predictions]\n",
    "    rank_score = np.mean(ranks, axis=0)\n",
    "    probability_score = np.mean(predictions, axis=0)\n",
    "\n",
    "    # Числа выбраны так, чтобы сохранить практически чистое ранговое смешивание,\n",
    "    # а 0.00001 помогает избежать равных итоговых значений\n",
    "    return 0.99999 * rank_score + 0.00001 * probability_score\n",
    "\n",
    "\n",
    "def evaluate_features(feature_frame, feature_columns, folds, seeds=(0,)):\n",
    "    rows = []\n",
    "    for fold_number, (valid_start, valid_end) in enumerate(folds, start=1):\n",
    "        train_mask = window_start.lt(valid_start).to_numpy()\n",
    "        valid_mask = window_start.ge(valid_start).to_numpy() & window_start.lt(valid_end).to_numpy()\n",
    "\n",
    "        model_predictions = {}\n",
    "        for model_name in ['catboost', 'lightgbm']:\n",
    "            seed_predictions = []\n",
    "            for seed in seeds:\n",
    "                prediction = fit_and_predict(\n",
    "                    model_name,\n",
    "                    feature_frame.loc[train_mask],\n",
    "                    target[train_mask],\n",
    "                    feature_frame.loc[valid_mask],\n",
    "                    feature_columns,\n",
    "                    seed,\n",
    "                )\n",
    "                seed_predictions.append(prediction)\n",
    "            model_predictions[model_name] = np.mean(seed_predictions, axis=0)\n",
    "\n",
    "        model_predictions['blend'] = rank_blend(list(model_predictions.values()))\n",
    "        for model_name, prediction in model_predictions.items():\n",
    "            rows.append({\n",
    "                'fold': fold_number,\n",
    "                'model': model_name,\n",
    "                'P@R0.7': precision_at_recall(target[valid_mask], prediction),\n",
    "                'PR-AUC': average_precision_score(target[valid_mask], prediction),\n",
    "            })\n",
    "    return pd.DataFrame(rows)"
   ]
  },
