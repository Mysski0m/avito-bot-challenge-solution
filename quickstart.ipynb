    "def add_new_features(baseline, meta, prepared_events):\n",
    "    regularity = build_regularity_features(meta, prepared_events)\n",
    "    pointer_types = build_pointer_type_features(meta, prepared_events)\n",
    "    item_sync = build_item_sync_features(meta, prepared_events)\n",
    "    restored = build_restored_features(meta, prepared_events)\n",
    "\n",
    "    result = baseline.merge(regularity, on='cookie_id', how='left')\n",
    "    result = result.merge(pointer_types, on='cookie_id', how='left')\n",
    "    result = result.merge(item_sync, on='cookie_id', how='left')\n",
    "    result = result.merge(restored, on='cookie_id', how='left')\n",
    "\n",
    "    new_columns = [\n",
    "        'gap_unique_share', 'gap_mad', 'gap_repeat_10s',\n",
    "        'pointer_share_search', 'pointer_share_item', 'pointer_share_photo',\n",
    "        'pointer_share_seller', 'pointer_share_contact',\n",
    "        'item_shared_mean', 'item_shared_max', 'item_shared_share',\n",
    "        'item_sync_mean', 'item_sync_max', 'item_sync_share',\n",
    "        'n_gaps', 'gap_mean', 'gap_max', 'gap_cv', 'gap_burst',\n",
    "        'gap_share_5s', 'gap_share_10s',\n",
    "        'pointer_x_unique', 'pointer_same_share',\n",
    "        'n_search_events', 'n_search_pages', 'search_page_range',\n",
    "        'deep_search_share', 'sequential_page_share',\n",
    "        'top_category_share', 'query_repeat_share',\n",
    "        'n_seller_types', 'n_platforms', 'is_headless', 'app_version',\n",
    "    ]\n",
    "    result[new_columns] = result[new_columns].apply(pd.to_numeric, errors='coerce')\n",
    "    return result, new_columns\n",
    "\n",
    "\n",
    "enhanced_train, new_columns = add_new_features(baseline_train, train, train_events)\n",
    "enhanced_test, _ = add_new_features(baseline_test, test, test_events)\n",
    "enhanced_columns = all_base_columns + new_columns\n",
    "\n",
    "print('признаков в простой baseline-модели:', len(baseline_columns))\n",
    "print('базовых агрегатов в enhanced:', len(all_base_columns))\n",
    "print('новых признаков:', len(new_columns))\n",
    "print('всего:', len(enhanced_columns))"
   ]
  },
